STACK_VERSION=9.5.5

# Password for the built-in "elastic" superuser (used by setup and for logging in).
ELASTIC_PASSWORD=change-me-elastic
# Password Kibana uses to talk to Elasticsearch (built-in kibana_system user).
KIBANA_SYSTEM_PASSWORD=change-me-kibana
# At least 32 characters; encrypts Kibana saved objects such as alert rules.
KIBANA_ENCRYPTION_KEY=change-me-to-32-or-more-random-characters

ES_HEAP=1g
