{
  "policy": {
    "_meta": {
      "description": "Roll over daily or at 10 GB per primary shard; delete after 14 days."
    },
    "phases": {
      "hot": {
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "10gb"
          }
        }
      },
      "delete": {
        "min_age": "14d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
